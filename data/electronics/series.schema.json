{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://johnpeng-cn.github.io/supplychain-insights/data/electronics/series.schema.json",
  "title": "电子元器件指标序列",
  "description": "产业链看板的数据文件。空文件表示还没接入。有数值时，每条序列必须带来源。",
  "type": "object",
  "additionalProperties": false,
  "required": ["updatedAt", "status", "series"],
  "properties": {
    "updatedAt": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "空数据时必须是 null。有数据时写发布这版 JSON 的日期。"
    },
    "status": {
      "enum": ["empty", "ok"]
    },
    "note": {
      "type": "string"
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "unit", "frequency", "sourceName", "sourceUrl", "points"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "description": "必须是 catalog.json 里 public 不为 false 的 id。"
          },
          "name": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "frequency": { "type": "string", "minLength": 1 },
          "sourceName": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri" },
          "note": { "type": "string" },
          "points": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "value"],
              "properties": {
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "value": { "type": ["number", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
